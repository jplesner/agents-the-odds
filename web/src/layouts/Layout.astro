---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} — Agents the Odds</title>
  </head>
  <body>
    <header class="bg-navy-dark border-b border-white/10">
      <div class="max-w-5xl mx-auto px-6 py-4 flex items-center gap-8">
        <a href="/" class="text-white font-bold text-lg no-underline hover:text-white">
          Agents the Odds
        </a>
        <nav class="flex gap-6">
          <a href="/" class="text-white/60 no-underline hover:text-white text-sm">Home</a>
          <a href="/episodes" class="text-white/60 no-underline hover:text-white text-sm">Episodes</a>
        </nav>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-10">
      <slot />
    </main>

    <footer class="max-w-5xl mx-auto px-6 py-6 border-t border-white/10 text-white/30 text-sm">
      Static site. Built from data at compile time.
    </footer>
  </body>
</html>
