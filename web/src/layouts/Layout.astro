---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} — Agents the Odds</title>
  </head>
  <body>
    <header>
      <a href="/" class="site-title">Agents the Odds</a>
      <nav>
        <a href="/">Home</a>
        <a href="/episodes">Episodes</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Static site. Built from data at compile time.</p>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }

  body {
    font-family: system-ui, sans-serif;
    max-width: 960px;
    margin: 2rem auto;
    padding: 0 1.25rem;
    color: #1a1a1a;
    line-height: 1.6;
  }

  header {
    display: flex;
    align-items: baseline;
    gap: 2rem;
    border-bottom: 2px solid #1a1a1a;
    padding-bottom: 0.75rem;
    margin-bottom: 2rem;
  }

  .site-title {
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    color: inherit;
  }

  nav a {
    margin-right: 1rem;
    color: #555;
    text-decoration: none;
  }

  nav a:hover { color: #1a1a1a; text-decoration: underline; }

  footer {
    margin-top: 3rem;
    border-top: 1px solid #ddd;
    padding-top: 1rem;
    color: #888;
    font-size: 0.875rem;
  }

  h1 { margin-top: 0; }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.95rem;
  }

  th, td {
    text-align: left;
    padding: 0.45rem 0.75rem;
    border: 1px solid #ddd;
  }

  th { background: #f5f5f5; font-weight: 600; }

  tr:nth-child(even) td { background: #fafafa; }

  .numbers {
    font-family: ui-monospace, monospace;
    letter-spacing: 0.04em;
  }

  blockquote {
    border-left: 3px solid #ccc;
    margin: 1rem 0;
    padding: 0.5rem 1rem;
    color: #555;
    font-style: italic;
  }

  a { color: #0066cc; }
  a:hover { text-decoration: none; }
</style>
