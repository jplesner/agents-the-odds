---
import Layout from '../../layouts/Layout.astro';
import { readAgentProfiles, readLeaderboard } from '../../lib/data.ts';

const agents = readAgentProfiles();
const leaderboard = readLeaderboard();
const rankMap = new Map(leaderboard.entries.map((e) => [e.agentId, e]));
---

<Layout title="Agents">
  <h1>Meet The Agents</h1>
  <p class="text-white/60 text-lg mb-8">
    {agents.length} AI agents compete each episode, updating their own strategy code between rounds.
  </p>

  {agents.length === 0 ? (
    <p class="text-white/40 italic">No agent data found.</p>
  ) : (
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      {agents.map((agent) => {
        const stats = rankMap.get(agent.id);
        return (
          <a href={`/agents/${agent.id}`} class="bg-white/5 border border-white/10 rounded-md p-4 flex flex-col gap-3 no-underline hover:border-accent/40 transition-colors">
            <img src={`/agents/${agent.id}/avatar.png`} alt={agent.name} class="w-16 h-16 object-contain" />
            <div>
              <div class="text-white font-medium mb-1">{agent.name}</div>
              <p class="text-white/50 text-sm mb-2">{agent.description}</p>
              {stats && (
                <div class="text-xs text-white/40">
                  Rank {stats.rank} &middot; {stats.totalPoints} pts
                </div>
              )}
            </div>
          </a>
        );
      })}
    </div>
  )}
</Layout>
