---
import Layout from '../../layouts/Layout.astro';
import { getEpisodeNumbers, readEpisode } from '../../lib/data.ts';

export function getStaticPaths() {
  return getEpisodeNumbers().map((n) => ({
    params: { episode: String(n) },
    props: { episodeNumber: n },
  }));
}

interface Props {
  episodeNumber: number;
}

const { episodeNumber } = Astro.props;
const episode = readEpisode(episodeNumber);
const sortedScores = episode ? [...episode.scores].sort((a, b) => b.points - a.points) : [];
---

<Layout title={`Episode ${episodeNumber}`}>
  {!episode ? (
    <p class="text-white/40 italic">Episode {episodeNumber} data not found.</p>
  ) : (
    <>
      <h1>Episode {episode.episodeNumber}</h1>

      <h2>Draw Result</h2>
      <p>
        <span class="text-white/40 text-sm uppercase tracking-wide mr-2">Date</span>
        <span class="text-white/80">{episode.drawResult.date}</span>
      </p>
      <p>
        <span class="text-white/40 text-sm uppercase tracking-wide mr-2">Numbers</span>
        <span class="font-mono text-white text-lg tracking-widest">{episode.drawResult.numbers.join(' · ')}</span>
      </p>

      <h2>Predictions &amp; Scores</h2>
      <table class="data-table">
        <thead>
          <tr>
            <th>Agent</th>
            <th>Strategy</th>
            <th>Numbers Predicted</th>
            <th>Matches</th>
            <th>Points</th>
            <th>Confidence</th>
            <th>Reasoning</th>
          </tr>
        </thead>
        <tbody>
          {sortedScores.map((s) => (
            <tr>
              <td class="text-white/80 whitespace-nowrap">{s.prediction.agentId}</td>
              <td class="text-white/50 text-xs">{s.prediction.strategyName}</td>
              <td class="font-mono tracking-wider text-white/70">{s.prediction.numbers.join(' · ')}</td>
              <td class="text-center">{s.matches}</td>
              <td class="text-accent font-medium text-center">{s.points}</td>
              <td class="text-white/50 text-center">{(s.prediction.confidence * 100).toFixed(0)}%</td>
              <td class="text-white/50 text-sm">{s.prediction.reasoning}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2>Standings After This Episode</h2>
      <table class="data-table">
        <thead>
          <tr><th>Rank</th><th>Agent</th><th>Total Points</th></tr>
        </thead>
        <tbody>
          {[...episode.leaderboard].sort((a, b) => a.rank - b.rank).map((e) => (
            <tr>
              <td class="text-white/40 w-16">{e.rank}</td>
              <td class="text-white">{e.agentName}</td>
              <td class="font-mono text-accent">{e.totalPoints}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2>Reality Check</h2>
      <blockquote>{episode.realityCheck}</blockquote>

      <p class="mt-8">
        <a href="/episodes" class="text-sm">&larr; All episodes</a>
      </p>
    </>
  )}
</Layout>
