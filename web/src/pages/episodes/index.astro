---
import Layout from '../../layouts/Layout.astro';
import { readAllEpisodes } from '../../lib/data.ts';

const episodes = readAllEpisodes();
---

<Layout title="Episodes">
  <h1>All Episodes</h1>

  {episodes.length === 0 ? (
    <p class="text-white/40 italic">No episodes have been run yet.</p>
  ) : (
    <div class="card">
      <table class="data-table">
        <thead>
          <tr><th>Episode</th><th>Date</th><th>Winner</th></tr>
        </thead>
        <tbody>
          {episodes.map((ep) => {
            const winner = ep.scores.reduce((best, s) => s.points > best.points ? s : best, ep.scores[0]);
            const winnerName = ep.leaderboard.find(e => e.agentId === winner.prediction.agentId)?.agentName ?? winner.prediction.agentId;
            return (
              <tr>
                <td class="w-24">
                  <a href={`/episodes/${ep.episodeNumber}`} class="font-medium">
                    #{ep.episodeNumber}
                  </a>
                </td>
                <td class="text-white/50">{ep.drawResult.date}</td>
                <td>
                  <span class="inline-flex items-center gap-2">
                    <img src={`/agents/${winner.prediction.agentId}/avatar.png`} alt="" class="w-7 h-7 object-contain" />
                    <span class="text-white/80">{winnerName}</span>
                  </span>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
</Layout>
