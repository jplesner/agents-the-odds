---
import Layout from '../../layouts/Layout.astro';
import { readAllEpisodes } from '../../lib/data.ts';

const episodes = readAllEpisodes();
---

<Layout title="Episodes">
  <h1>All Episodes</h1>
  {episodes.length === 0 ? (
    <p>No episodes have been run yet.</p>
  ) : (
    <table>
      <thead>
        <tr><th>Episode</th><th>Date</th><th>Draw</th><th>Episode Winner</th></tr>
      </thead>
      <tbody>
        {episodes.map((ep) => {
          const winner = ep.leaderboard.find((e) => e.rank === 1);
          const episodeWinner = ep.scores.reduce((best, s) => s.points > best.points ? s : best, ep.scores[0]);
          return (
            <tr>
              <td><a href={`/episodes/${ep.episodeNumber}`}>{ep.episodeNumber}</a></td>
              <td>{ep.drawResult.date}</td>
              <td class="numbers">{ep.drawResult.numbers.join(' · ')}</td>
              <td>{episodeWinner.prediction.agentId} ({episodeWinner.points} pts)</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  )}
</Layout>
